# Copy this file to .env and adjust values before running `docker compose up`.
# Never commit your real .env file.

# --- Postgres ---
POSTGRES_USER=pubcash
POSTGRES_PASSWORD=pubcash
POSTGRES_DB=pubcash

# --- Backend ---
# Must match the Postgres settings above.
DATABASE_URL=postgresql+psycopg2://pubcash:pubcash@db:5432/pubcash

# Generate a real secret for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# The first admin account, created automatically the first time the backend starts.
# Change this password immediately after first login.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe123!

# Amount (GBP) a till session's variance must reach before it shows up as a discrepancy alert.
VARIANCE_ALERT_THRESHOLD=5.00

# Anyone registering a new account must enter this code (share it with staff verbally, on a
# notice board, etc. - it's not meant to be secret from the whole world, just enough to keep
# random internet strangers from filling up your pending-approval list). Change it any time by
# editing this value and restarting the backend; existing accounts are unaffected. Required in
# production (docker-compose.prod.yml refuses to start without it).
REGISTRATION_INVITE_CODE=change-me-invite-code

# How many minutes of inactivity before a logged-in user is automatically logged out. This is a
# SLIDING timeout - any request to the API (loading a page, checking a balance, etc.) resets the
# clock, so an actively-used session never expires, but a terminal left logged in and untouched
# gets kicked back to the login screen after this many minutes.
SESSION_IDLE_TIMEOUT_MINUTES=10

# --- Frontend ---
# Used only by `docker-compose.yml` (local dev). The URL the browser will use to reach the
# backend API directly. Not used in production - docker-compose.prod.yml always builds the
# frontend to call same-origin /api, proxied by Caddy.
VITE_API_URL=http://localhost:8000

# --- Production only (docker-compose.prod.yml) ---
# Your domain's DNS A record must already point at the server's public IP before you start
# the stack, or Caddy won't be able to get a certificate.
DOMAIN=cash.example.com

# Email Let's Encrypt will use for renewal/expiry notices. Any address you check works.
CADDY_ACME_EMAIL=admin@example.com
